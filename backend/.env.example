# Backend Budes — konfigurasi dua-DB (PRD §5)
PORT=8080

# App DB (writable) — layer transaksional Budes
APP_DATABASE_URL=postgres://budes:budes@localhost:5434/budes_app

# Reference DB (read-only) — cermin lokal dataset KDMP
REF_DATABASE_URL=postgres://budes:budes@localhost:5433/hackathon_2026

# Auth
JWT_SECRET=budes-dev-secret-change-me

# Notifikasi WhatsApp (OpenWA gateway) — WA_API_KEY RAHASIA, jangan commit
# Endpoint: POST {WA_BASE_URL}/api/sessions/{WA_SESSION}/messages/send-text (header X-API-Key)
# CATATAN gateway ini: {WA_SESSION} = nilai API key. Sesi WhatsApp harus CONNECTED
# di dashboard (scan QR); bila belum, gateway balas 404 "Session not found".
WA_BASE_URL=
WA_SESSION=
WA_API_KEY=
WA_GROUP_CHAT_ID=120363428225078710@g.us