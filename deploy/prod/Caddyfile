# Reverse proxy Budes — satu origin. Ganti `:80` jadi domain (mis. budes.example.com)
# untuk HTTPS otomatis (Caddy urus TLS Let's Encrypt sendiri).
:80 {
	encode gzip

	# API Go (+ /health) → service api
	@api path /api/* /health
	handle @api {
		reverse_proxy api:8080
	}

	# Sisanya → frontend Nuxt (SSR)
	handle {
		reverse_proxy frontend:8080
	}
}
