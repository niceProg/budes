# Reverse proxy Budes — dua domain, HTTPS otomatis (Let's Encrypt via Caddy).
# Syarat: DNS kedua domain -> IP VM, port 80 & 443 terbuka di firewall.

# Frontend (Nuxt SSR)
budes.yum-dev.com {
	encode gzip
	reverse_proxy frontend:8080
}

# Backend (Go REST). Endpoint: https://api-budes.yum-dev.com/api/... dan /health
api-budes.yum-dev.com {
	encode gzip
	reverse_proxy api:8080
}
