# Env produksi VM — SALIN ke /home/yumna/budes-config/prod.env di VM lalu isi.
# TIDAK dikomit (rahasia). Dibaca compose via: docker compose --env-file .../prod.env ...

# Password Postgres App DB (container). Acak & kuat.
POSTGRES_PASSWORD=ganti-password-kuat

# Kunci JWT (HS256). Acak & panjang.
JWT_SECRET=ganti-string-acak-panjang

# Ref DB (KDMP, read-only). Password di-URL-encode (@ → %40, * → %2A).
REF_DATABASE_URL=postgres://hackathon_participant_2026:%2AH4ck4thonK3men0P2026%40@34.101.155.200:5432/hackathon_2026?sslmode=require

# URL API publik untuk frontend (browser). Kosong = mock-first.
NUXT_PUBLIC_API_BASE=https://api-budes.yum-dev.com
# Base API internal untuk SSR (opsional; default http://api:8080 di compose).
NUXT_API_BASE_SERVER=http://api:8080

# WhatsApp (opsional). Kosong = notifikasi dilewati.
WA_BASE_URL=
WA_SESSION=default
WA_API_KEY=
WA_GROUP_CHAT_ID=120363428225078710@g.us
